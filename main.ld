PROGRAM main
  VAR
    TANK_START : BOOL AT %IX0.0; (* Tank start button *)
    TANK_STOP : BOOL AT %IX0.1; (* Tank stop button *)
    LOW_LEVEL : BOOL AT %IX0.2; (* TRUE = water above 20% *)
    HIGH_LEVEL : BOOL AT %IX0.3; (* TRUE = water at 85% *)
    PUMP : BOOL AT %QX0.0; (* Tank pump *)
    FULL_LAMP : BOOL AT %QX0.1; (* Tank full lamp alert *)
    TANK_ON : BOOL; (* System running *)
    LINE_START : BOOL AT %IX0.4; (* Line start button *)
    LINE_STOP : BOOL AT %IX0.5; (* Line stop button *)
    ESTOP_OK : BOOL AT %IX0.6; (* TRUE = E-stop NOT pressed (NC) *)
    ALARM_RESET : BOOL AT %IX0.7; (* Alarm reset button *)
    BOTTLE_AT_FILLER : BOOL AT %IX1.0; (* Photo-eye at filler *)
    BOTTLE_AT_CAPPER : BOOL AT %IX1.1; (* Photo-eye at capper *)
    BOTTLE_AT_QC : BOOL AT %IX1.2; (* Photo-eye at QC *)
    QC_DONE : BOOL AT %IX1.3; (* QC scan finished *)
    QC_DAMAGE : BOOL AT %IX1.4; (* Camera found crack or dent *)
    QC_NO_CAP : BOOL AT %IX1.5; (* Camera found no cap *)
    BOTTLE_IN_CRATE : BOOL AT %IX1.6; (* Bottle entered good crate *)
    BOTTLE_IN_REJECT : BOOL AT %IX1.7; (* Bottle entered reject bin *)
    CRATE_PRESENT : BOOL AT %IX2.0; (* Crate is in place *)
    FILLER_ML : INT AT %IW0; (* ml in bottle at filler *)
    QC_ML : INT AT %IW1; (* ml measured at QC *)
    TARGET_ML : INT AT %IW2; (* Fill target from operator *)
    BOTTLE_RELEASE : BOOL AT %QX0.2; (* Feeder gate: release one bottle *)
    CONVEYOR : BOOL AT %QX0.3; (* Conveyor motor *)
    FILL_FAST : BOOL AT %QX0.4; (* Fast fill valve *)
    FILL_SLOW : BOOL AT %QX0.5; (* SLOW fill valve *)
    CAPPER : BOOL AT %QX0.6; (* Cap press *)
    QC_SCAN : BOOL AT %QX0.7; (* Start QC scan *)
    DIVERTER : BOOL AT %QX1.0; (* Push bottle to reject bin *)
    GREEN_LAMP : BOOL AT %QX1.1; (* Running *)
    AMBER_LAMP : BOOL AT %QX1.2; (* Waiting (water / crate) *)
    RED_LAMP : BOOL AT %QX1.3; (* Fault *)
    LINE_ON : BOOL; (* Line is running *)
    READY : BOOL; (* Ok to start a new bottle *)
    BUSY : BOOL; (* A bottle is on its way *)
    RELEASED : BOOL; (* Feeder gate open 0.5 second *)
    FILLING : BOOL; (* Filter is working *)
    FAST_DONE : BOOL; (* Bottle reached fast limit *)
    FILL_TIMEOUT : BOOL; (* Filling took too long *)
    FILLED : BOOL; (* Filler job finished *)
    CAP_TIME_UP : BOOL; (* Capper pressed 1 second *)
    CAPPED : BOOL; (* Capper job finished *)
    SCANNED : BOOL; (* QC job finished *)
    UNDERFILL : BOOL; (* QC ml too low *)
    OVERFILL : BOOL; (* QC ml too high *)
    QC_FAIL : BOOL; (* QC found a problem *)
    BAD_BOTTLE : BOOL; (* Bottle must be reject *)
    CRATE_REMOVED : BOOL; (* Crate taken away *)
    CRATE_FULL : BOOL; (* 12 bottles in crate *)
    BIN_FULL : BOOL; (* 10 bottles in reject bin *)
    JAM : BOOL; (* Conveyor ran too long *)
    FAULT : BOOL; (* Line stopped by a fault *)
    FAST_LIMIT : INT; (* Target minus 50 *)
    MIN_ML : INT; (* Target minus 10 *)
    MAX_ML : INT; (* Target plus 10 *)
    GOOD_COUNT : INT; (* Bottles in crate *)
    REJECT_COUNT : INT; (* Bottles in reject bin *)
    FILL_DONE : BOOL; (* Bottle reach target *)
    CTU0 : CTU;
    CTU1 : CTU;
    TON0 : TON;
    TON1 : TON;
    TON2 : TON;
    TON3 : TON;
  END_VAR

